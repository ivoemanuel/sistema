<div class="page-header">
    <h1>Notas Pessoais</h1>
</div>

<div class="card">
    <h2>Suas notas</h2>
    <p class="text-muted mb-1">Lista de afazeres e rascunhos privados — visível apenas para você.</p>

    <form id="new-note-form" class="new-note-form">
        <input type="text" id="new-note-input" placeholder="Adicionar novo item..." required />
        <button type="submit" class="btn btn--primary">Adicionar</button>
    </form>

    <ul class="todo-list" id="todo-list" data-notes='{{{json notes}}}'></ul>
    <p class="empty-state" id="empty-state" style="display:none;">Nenhuma nota por aqui. Adicione a primeira!</p>
</div>

<script src="/js/notes.js"></script>
